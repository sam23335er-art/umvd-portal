{
  "name": "umvd-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "tsc -b && vite build",
    "build:api": "esbuild server/api.ts --bundle --platform=node --target=node20 --format=esm --outfile=api/index.js --external:pg-native --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "check": "tsc -b && tsc -p tsconfig.server.json",
    "test": "tsx --test tests/local.test.ts",
    "serve:server": "tsx server/dev.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "html2canvas-pro": "^2.5.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.60.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "description": "УМВД | Служебный портал — Кемерово RP (ролевой проект). Только React, без сервера."
}
